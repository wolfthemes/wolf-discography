{
	"name": "wolfthemes/wolf-discography",
	"description": "A discography plugin to display your releases.",
	"type": "wordpress-plugin",
	"homepage": "https://github.com/wolfthemes/wolf-discography",
	"authors": [
		{
			"name": "WolfThemes",
			"email": "contact@wolfthemes.com",
			"homepage": "https://wolfthemes.com"
		}
	],
	"autoload": {
        "psr-4": {
            "wolf-discography\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wolf-discography\\Tests\\": "tests/"
        }
    },
	"require": {
		"php": ">=7.4",
        "wp-coding-standards/wpcs": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "woocommerce/woocommerce-sniffs": "^0.1.3",
        "vlucas/phpdotenv": "^5.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11",
        "phpunit/phpunit": "*"
    }
}